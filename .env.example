# Copy to .env and fill in. All vars are prefixed SAAD_GPT_ per config.py.

SAAD_GPT_DATABASE_URL=postgresql+psycopg://saad_gpt:saad_gpt@localhost:5432/saad_gpt

# Optional — enables Claude-assisted auto-tagging (Phase 3, R5), the Manager's
# synthesis view (Section 6.1 step 4), and the chat interface. All are skipped
# cleanly if unset.
SAAD_GPT_ANTHROPIC_API_KEY=

# R4: minimum confidence before an auto-tag is trusted rather than defaulted/dropped.
SAAD_GPT_TAGGING_MIN_CONFIDENCE=0.6

# Optional — fallback Instagram account-listing when yt-dlp can't enumerate a
# profile's posts directly (see ingestion/instagram.py).
SAAD_GPT_APIFY_API_TOKEN=

SAAD_GPT_WHISPER_MODEL=base
SAAD_GPT_WHISPER_DEVICE=cpu
SAAD_GPT_WHISPER_COMPUTE_TYPE=int8
